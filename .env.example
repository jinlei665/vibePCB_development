# VibePCB 环境变量示例（复制为 .env 或直接 export，严禁提交真实密钥）
# 注意：后端**只从环境变量读取**，不解析 .env 文件；Windows 建议用 setx：
#   setx DEEPSEEK_API_KEY "sk-xxxx"
# DeepSeek API Key（必填才走真实 AI；不填自动降级规则引擎）
DEEPSEEK_API_KEY=
# 可选覆盖
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
# DEEPSEEK_TIMEOUT_S=60
# PCB 引擎：auto | pcbnew | simulated（无 KiCad 环境用 simulated）
# VIBEPCB_PCB_ENGINE=auto
# VIBEPCB_PORT=8710
# 运行时数据目录（默认 ~/.vibepcb）
# VIBEPCB_DATA_DIR=
# 公网部署必设：非空则所有 /api（除 /api/health）要求 Bearer / X-API-Token 凭据
# VIBEPCB_API_TOKEN=
# 公网部署 CORS 白名单（逗号分隔 origin）
# VIBEPCB_CORS_ORIGINS=https://your.domain
# Electron 壳可选覆盖：指定后端解释器与后端目录
# VIBEPCB_PYTHON=
# VIBEPCB_BACKEND_DIR=

# VibePCB 环境变量示例（复制为 .env 或直接 export，严禁提交真实密钥）
# DeepSeek API Key（必填才走真实 AI；不填自动降级规则引擎）
DEEPSEEK_API_KEY=
# 可选覆盖
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
# PCB 引擎：auto | pcbnew | simulated（无 KiCad 环境用 simulated）
# VIBEPCB_PCB_ENGINE=auto
# VIBEPCB_PORT=8710
